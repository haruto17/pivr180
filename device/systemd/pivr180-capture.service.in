[Unit]
Description=pivr180 capture software

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DEVICE_DIR@
# Not a route via wlan0 or eth0: the camera sync multicast must work with no network connected.
# Not 224.0.0.0/4: it would also pull onto lo other multicast sent without an explicit interface.
ExecStartPre=+/usr/sbin/ip link set lo multicast on
ExecStartPre=+/usr/sbin/ip route replace 239.255.255.250/32 dev lo
# Not `uv run`: it may recreate the venv from .python-version without --system-site-packages.
ExecStart=@DEVICE_DIR@/.venv/bin/pivr180-capture
# Not User=root: only binding the web UI to port 80 needs privileges.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
# Not SIGTERM: only KeyboardInterrupt stops the preview and releases the cameras and serial before exiting.
KillSignal=SIGINT
SuccessExitStatus=130

[Install]
WantedBy=multi-user.target
